# Logs & System
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
firebase-debug.log*
firebase-debug.*.log*
rufus.log

# Firebase & Deployment Cache
.firebase/
.dataconnect/

# Runtime data & PIDs
pids
*.pid
*.seed
*.pid.lock

# Test & Coverage
coverage/
.nyc_output/
lib-cov/
.grunt/
bower_components/
.lock-wscript
build/Release/

# Node dependencies & Caches
node_modules/
.npm/
.eslintcache
.node_repl_history
*.tgz
.yarn-integrity

# Secrets, Environment Variables & Service Account Keys
.env
*.env
.env.*
!.env.example
!*.env.example
serviceAccountKey.json
*serviceAccountKey*.json
ATLAS_SECRETS_BACKUP.md
*.pem
*.key

# Python Virtual Environments & Caches
venv/
**/venv/
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
.cache
**/.cache
.cache/
**/.cache/
*.egg-info/
dist/
build/

# Local Databases & Vector Stores
*.sqlite
*.sqlite3
chroma_db/
**/chroma_db/
pensieve_db.sqlite

# Heavy ML Models & Model Weights (Download separately)
*.pt
*.ckpt
*.onnx
*.bin
pretrained_models/

# Personal Biometric Media & Screen/Webcam Recordings
*.webm
*.wav
*.mp4
*.avi
data/*.jpg
data/*.png
interface/WhatsApp*
interface/*.jpeg
interface/*.jpg
interface/*.png

# Personal Chat History, Prompt Dumps & Diagnostic Notes
full_chat_history*.txt
user_prompts*.txt
temp_features.txt
project_atlas_protocol.md
resume_details_form.md

# Legacy & Scratch Archives & Scripts

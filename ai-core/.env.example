# ==============================================================================
# PROJECT ATLAS (v1.0) - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and populate with your own credentials.
# NEVER commit your real .env file or private service accounts to git.

# ------------------------------------------------------------------------------
# 1. LLM Cognitive Engines (Google Gemini API)
# ------------------------------------------------------------------------------
# Primary API key for Atlas Supervisor & Multi-Agent Swarm reasoning
GEMINI_API_KEY=your_gemini_api_key_here

# Secondary & Heartbeat failover keys for high-availability rotation
GEMINI_API_KEY_2=your_secondary_gemini_key_here
GEMINI_API_KEY_HEARTBEAT=your_heartbeat_gemini_key_here

# Optional: Fallback Cognitive Engines
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_anthropic_key_here

# ------------------------------------------------------------------------------
# 2. Biorhythm DJ (Spotify Developer Web API)
# ------------------------------------------------------------------------------
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080

# ------------------------------------------------------------------------------
# 3. Commlink & Remote Nervous System (Discord Bot & Motor Cortex)
# ------------------------------------------------------------------------------
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CHANNEL_ID=your_discord_channel_id_here

# Motor Cortex / Command Server
COMMAND_SERVER_HOST=0.0.0.0
COMMAND_SERVER_PORT=8000
